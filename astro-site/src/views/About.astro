---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Operator from '../components/home/Operator.astro';
import Production from '../components/home/Production.astro';
import Process from '../components/home/Process.astro';
import CallCta from '../components/CallCta.astro';
import { site, type Lang } from '../data/site';
import { about, t } from '../data/content';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const es = lang === 'es';
const a = about(lang);
const member = t(lang).team.members[0];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    url: new URL(path, site.url).href,
    inLanguage: es ? 'es-MX' : 'en',
    about: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}/#kevin`,
    name: member.name,
    jobTitle: member.role,
    description: member.bio,
    worksFor: { '@id': `${site.url}/#organization` },
    address: { '@type': 'PostalAddress', addressLocality: 'Aguascalientes', addressCountry: 'MX' },
  },
];
---

<Base
  lang={lang}
  title={es ? 'Sobre nosotros' : 'About us'}
  description={es ? 'Conoce a CreamosTech: agencia de marketing digital de Aguascalientes que impulsa el crecimiento digital de sus clientes.' : 'Meet CreamosTech: a digital marketing agency from Aguascalientes, Mexico, driving digital growth for its clients.'}
  path={path}
  schema={schema}
>
  <PageHead
    lang={lang}
    title={es ? 'Somos el equipo que hace crecer marcas' : 'We are the team that grows brands'}
    lead={es ? 'Nuestra misión: impulsar el crecimiento digital de nuestros clientes.' : 'Our mission: driving digital growth for our clients.'}
    crumbs={[{ label: es ? 'Nosotros' : 'About' }]}
  />

  <section class="section" aria-labelledby="log-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="log-title" class="display-2">{es ? 'Nuestra historia' : 'Our journey'}</h2>
      </header>
      <ol class="log">
        {
          a.timeline.map((m) => (
            <li>
              <p class="year">{m.year}</p>
              <h3>{m.title}</h3>
              <p class="desc">{m.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Operator lang={lang} />

  <section class="section" aria-labelledby="cult-title">
    <div class="wrap culture">
      <h2 id="cult-title" class="display-2">{es ? 'Nuestra cultura' : 'Our culture'}</h2>
      <ul>
        {
          a.culture.map((c) => (
            <li>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="tools" aria-labelledby="tools-title">
    <div class="wrap tools-row">
      <h2 id="tools-title" class="display-3">{es ? 'Nuestras herramientas' : 'Our tools'}</h2>
      <ul class="data">
        {a.tools.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  </section>

  <Production lang={lang} />
  <Process lang={lang} />
  <CallCta lang={lang} />
</Base>

<style>
  .log {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-top: 6px solid var(--rule-strong);
  }
  .log li {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.6rem 1.25rem 0 0;
  }
  .log li::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ground);
    border: 4px solid var(--green);
  }
  .log li:last-child::before {
    border-color: var(--amber);
  }
  .year {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--amber);
  }
  .log h3 {
    font-size: 1.35rem;
    font-stretch: 80%;
  }
  .desc {
    color: var(--text-2);
    font-size: 0.96rem;
  }
  .culture {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .culture ul {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--rule-strong);
  }
  .culture li {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 1.5rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .culture h3 {
    font-size: 1.5rem;
    font-stretch: 78%;
  }
  .culture p {
    color: var(--text-2);
  }
  .tools {
    border-block: 1px solid var(--rule);
    background: var(--panel);
  }
  .tools-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    align-items: center;
    padding-block: 2rem;
  }
  .tools ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tools li {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.8rem;
  }
  @media (max-width: 1000px) {
    .log {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2rem;
    }
    .culture {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .culture li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
