---
// The unit a station produces, drawn as a real CSS 3D box that tilts with the pointer.
import Icon from './Icon.astro';

interface Props {
  icon: string;
  code: string;
  label: string;
}
const { icon, code, label } = Astro.props;
---

<div class="unit-stage" aria-hidden="true" data-tilt>
  <div class="belt"></div>
  <div class="cube">
    <div class="face front"><Icon name={icon} /></div>
    <div class="face right"><span class="data">{code}</span></div>
    <div class="face top"><span class="data">{label}</span></div>
  </div>
</div>

<style>
  .unit-stage {
    --rx: -22deg;
    --ry: -36deg;
    --s: clamp(130px, 14vw, 200px);
    position: relative;
    width: calc(var(--s) * 2.1);
    height: calc(var(--s) * 2);
    perspective: 1100px;
    display: grid;
    place-items: center;
  }
  .belt {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 12%;
    height: 26%;
    background: repeating-linear-gradient(90deg, #1c201e 0 22px, #262a27 22px 26px);
    border: 1px solid var(--rule-strong);
    transform: perspective(700px) rotateX(62deg);
    transform-origin: bottom;
    border-radius: 4px;
  }
  .cube {
    position: relative;
    width: var(--s);
    height: var(--s);
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.6s var(--ease-out);
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 6px;
    backface-visibility: hidden;
  }
  .front {
    background: linear-gradient(160deg, #ffc23d, #f2a100);
    color: var(--amber-ink);
    transform: translateZ(calc(var(--s) / 2));
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
  }
  .front :global(svg) {
    width: 46%;
    height: 46%;
    stroke-width: 1.3;
  }
  .right {
    background: linear-gradient(160deg, #c98a00, #9c6b00);
    color: rgb(27 19 0 / 0.75);
    transform: rotateY(90deg) translateZ(calc(var(--s) / 2));
  }
  .top {
    background: linear-gradient(160deg, #ffdf8f, #ffc84a);
    color: rgb(27 19 0 / 0.7);
    transform: rotateX(90deg) translateZ(calc(var(--s) / 2));
  }
  .right .data,
  .top .data {
    font-size: 0.8rem;
  }
  @media (max-width: 900px) {
    .unit-stage {
      --s: 120px;
    }
  }
</style>

<script>
  const fine = matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
    if (!fine) return;
    window.addEventListener(
      'pointermove',
      (e) => {
        const x = e.clientX / window.innerWidth - 0.5;
        const y = e.clientY / window.innerHeight - 0.5;
        el.style.setProperty('--ry', `${-36 + x * 30}deg`);
        el.style.setProperty('--rx', `${-22 - y * 16}deg`);
      },
      { passive: true },
    );
  });
</script>
