---
import Icon from '../Icon.astro';
import type { Lang } from '../../data/site';
import { homeTestimonials, t } from '../../data/content';
import { u } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = u(lang);
const tt = t(lang).testimonials;
const quotes = homeTestimonials(lang);
const [lead, ...rest] = quotes;
const initials = (n: string) =>
  n
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2);
---

<section class="section signoffs" id="testimonios" aria-labelledby="qc-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="qc-title" class="display-2">{tt.title}</h2>
      <p class="lead">{tt.description}</p>
    </header>

    <figure class="sheet lead-q">
      <blockquote>“{lead.quote}”</blockquote>
      <figcaption>
        <span class="mono" aria-hidden="true">{initials(lead.author)}</span>
        <span>
          <b>{lead.author}</b>
          <span>{lead.role}, {lead.company}</span>
        </span>
        <span class="stamp" aria-hidden="true"><Icon name="check" />{s.qcStamp}</span>
      </figcaption>
    </figure>

    <ul class="others">
      {
        rest.map((q) => (
          <li>
            <figure class="sheet">
              <blockquote>“{q.quote}”</blockquote>
              <figcaption>
                <span class="mono" aria-hidden="true">
                  {initials(q.author)}
                </span>
                <span>
                  <b>{q.author}</b>
                  <span>
                    {q.role}, {q.company}
                  </span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sheet {
    margin: 0;
    display: grid;
    gap: 1.5rem;
    align-content: space-between;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  blockquote {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.55;
  }
  .lead-q {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    border-color: var(--rule-strong);
  }
  .lead-q blockquote {
    font-size: clamp(1.45rem, 2.7vw, 2.35rem);
    font-weight: 600;
    font-stretch: 85%;
    line-height: 1.25;
    letter-spacing: -0.01em;
    max-width: 38ch;
    text-wrap: pretty;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.2rem;
    border-top: 1px dashed var(--rule-strong);
  }
  figcaption > span:nth-child(2) {
    display: grid;
    line-height: 1.3;
  }
  figcaption b {
    font-weight: 750;
  }
  figcaption > span:nth-child(2) span {
    color: var(--text-2);
    font-size: 0.92rem;
  }
  .mono {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 50%;
    background: var(--panel-2);
    border: 1px solid var(--rule-strong);
    font: 600 0.78rem/1 var(--font-mono);
    color: var(--text-2);
  }
  .stamp {
    margin-left: auto;
    padding: 0.4rem 0.65rem;
    border: 2px solid var(--green);
    color: var(--green);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    rotate: -3deg;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .stamp :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2.4;
  }
  .others {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (max-width: 900px) {
    .others {
      grid-template-columns: 1fr;
    }
    .stamp {
      display: none;
    }
  }
</style>
