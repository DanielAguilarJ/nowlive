---
import SevenSeg from '../SevenSeg.astro';
import type { Lang } from '../../data/site';
import { t } from '../../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const st = t(lang).stats;
---

<section class="section production" aria-labelledby="prod-title">
  <div class="wrap grid">
    <header class="section-head">
      <h2 id="prod-title" class="display-2">{st.title}</h2>
      <p class="lead">{st.description}</p>
    </header>
    <ul class="wall screwed">
      {
        st.items.map((it: { number: number; suffix: string; label: string; description: string }, i: number) => (
          <li>
            <p class="code data">
              IND-0{i + 1}
              <span class="lamp" data-state="green" aria-hidden="true" />
            </p>
            <p class="readout">
              <SevenSeg value={it.number} label={`${it.number}${it.suffix}`} />
              <span class="unit">{it.suffix}</span>
            </p>
            <p class="lbl">{it.label}</p>
            <p class="desc">{it.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.7fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .section-head {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    margin: 0;
  }
  .wall {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background-color: #111412;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 8px;
  }
  .wall li {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding: 1.2rem 1.25rem 1.5rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .wall li:nth-child(3n) {
    border-right: 0;
  }
  .wall li:nth-last-child(-n + 3) {
    border-bottom: 0;
  }
  .code {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-3);
    margin-bottom: 0.6rem;
  }
  .readout {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    min-height: 3.6rem;
  }
  .readout :global(.seg) {
    --seg-h: 3.1rem;
  }
  .unit {
    font-weight: 800;
    font-stretch: 70%;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--amber);
  }
  .lbl {
    font-weight: 750;
    font-stretch: 85%;
    font-size: 1.05rem;
    margin-top: 0.4rem;
  }
  .desc {
    color: var(--text-2);
    font-size: 0.92rem;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .wall {
      grid-template-columns: 1fr 1fr;
    }
    .wall li:nth-child(3n) {
      border-right: 1px solid var(--rule);
    }
    .wall li:nth-child(2n) {
      border-right: 0;
    }
    .wall li:nth-last-child(-n + 3) {
      border-bottom: 1px solid var(--rule);
    }
    .wall li:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
    .readout :global(.seg) {
      --seg-h: 2.4rem;
    }
  }
</style>
