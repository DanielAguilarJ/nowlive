---
import Icon from '../Icon.astro';
import SevenSeg from '../SevenSeg.astro';
import { href, waLink, type Lang } from '../../data/site';
import { t } from '../../data/content';
import { u } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = u(lang);
const hero = t(lang).hero;
const rotating: string[] = hero.rotating;
const chipIcons = ['shield', 'whatsapp', 'clock'];
const labelNames = [s.lineStages[0], ...s.lineStages.slice(1)];
const labelCodes = ['', 'P-1', 'P-2', 'P-3', 'P-4'];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="stage" data-line>
    <svg class="poster" viewBox="0 0 800 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="none" stroke="var(--rule-strong)" stroke-width="1">
        <path d="M80 300 L720 160 M96 330 L736 190"></path>
        {[0, 1, 2, 3].map((i) => <rect x={250 + i * 110} y={170 - i * 24} width="26" height="120" />)}
        {Array.from({ length: 22 }, (_, i) => <circle cx={60 + (i % 6) * 22} cy={150 + Math.floor(i / 6) * 30} r="1.6" fill="var(--text-3)" />)}
      </g>
      <g fill="var(--rule-strong)">
        {Array.from({ length: 12 }, (_, i) => <rect x={150 + i * 48} y={281 - i * 10.5} width="20" height="14" />)}
      </g>
    </svg>
    <canvas aria-hidden="true"></canvas>
    <p class="sr-only">{s.lineCaption}: {s.lineStages.join(', ')}</p>
    <div class="labels" aria-hidden="true">
      {
        labelNames.map((name, i) => (
          <span class="tag data" data-label>
            {labelCodes[i] && <i>{labelCodes[i]}</i>}
            {name}
          </span>
        ))
      }
    </div>
  </div>

  <div class="wrap content">
    <h1 id="hero-title" class="display-1 c-head">
      <span class="h-main">{hero.headline}</span>
      <span class="rotor" aria-hidden="true">
        {rotating.map((w, i) => <span style={`--i:${i}`}>{w}</span>)}
      </span>
      <span class="sr-only">{rotating[0]}</span>
    </h1>

    <div class="c-body">
    <p class="lead">{hero.subheadline}</p>

    <div class="ctas">
      <a class="btn" href={href(lang, '/contact') + '#auditoria'} data-andon>
        {s.heroAudit}
        <Icon name="arrow" />
      </a>
      <a class="btn btn--ghost" href={waLink(s.whatsappHello)} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        {s.heroWhatsapp}
      </a>
    </div>

    <ul class="chips">
      {
        s.heroChips.map((c, i) => (
          <li>
            <Icon name={chipIcons[i]} />
            {c}
          </li>
        ))
      }
    </ul>
    </div>
  </div>

  <div class="wrap board-wrap">
    <div class="board screwed" role="group" aria-label={s.boardTitle}>
      <div class="board-title data">
        <p><span class="lamp" data-state="green" aria-hidden="true"></span>{s.boardTitle}</p>
        <ul class="status" aria-label={lang === 'es' ? 'Datos de la agencia' : 'Agency facts'}>
          {s.status.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <ul class="counters">
        {
          hero.stats.map((st: { value: number; suffix: string; label: string }) => (
            <li>
              <span class="readout">
                <SevenSeg value={st.value} label={`${st.value}${st.suffix}`} />
                <span class="unit">{st.suffix.trim()}</span>
              </span>
              <span class="lbl">{st.label}</span>
            </li>
          ))
        }
      </ul>
      <a class="cord" href={href(lang, '/contact') + '#auditoria'} data-andon data-cord>
        <span class="rope" aria-hidden="true"><span class="handle"></span></span>
        <span class="cord-text">
          <strong>{s.cord.label}</strong>
          <span>{s.cord.hint}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: clip;
    isolation: isolate;
    background:
      radial-gradient(120% 80% at 78% 40%, #1a1e1b 0%, transparent 60%),
      var(--ground);
  }
  .stage {
    position: absolute;
    inset: 0 0 0 40%;
    z-index: -1;
  }
  .stage canvas,
  .stage .poster {
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 34%), linear-gradient(0deg, transparent 0%, #000 30%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0%, #000 34%), linear-gradient(0deg, transparent 0%, #000 30%);
    mask-composite: intersect;
  }
  .poster,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .poster {
    transition: opacity 0.8s var(--ease-out);
  }
  canvas {
    opacity: 0;
    transition: opacity 1.1s var(--ease-out);
  }
  @media (pointer: fine) {
    canvas:global(.ready) {
      cursor: grab;
    }
    canvas:global(.grabbing) {
      cursor: grabbing;
    }
  }
  /* The text column sits over the stage: let drags reach the 3D line outside the copy. */
  .content {
    pointer-events: none;
  }
  .content > *,
  .c-body > * {
    pointer-events: auto;
  }
  canvas:global(.ready) {
    opacity: 1;
  }
  .stage:has(canvas:global(.ready)) .poster {
    opacity: 0;
  }
  .labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  .tag {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    translate: -50% -100%;
    display: inline-flex;
    gap: 0.5em;
    padding: 0.35rem 0.55rem;
    background: rgb(21 24 22 / 0.92);
    border: 1px solid var(--rule-strong);
    color: var(--text);
    white-space: nowrap;
    transition: opacity 0.4s;
  }
  .tag i {
    font-style: normal;
    color: var(--amber);
  }

  .content {
    align-self: center;
    padding-block: clamp(1.5rem, 4vh, 3.5rem) 2rem;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .content > * {
    max-width: 36rem;
  }
  .c-body {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  h1 {
    text-transform: uppercase;
    display: grid;
    gap: 0.06em;
  }
  .rotor {
    display: grid;
    color: var(--amber);
    min-height: 1.8em;
  }
  .rotor span {
    grid-area: 1 / 1;
    align-self: start;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rotor span {
      opacity: 0;
      animation: flip 12s var(--ease-out) infinite;
      animation-delay: calc(var(--i) * 3s);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rotor span:not(:first-child) {
      display: none;
    }
  }
  @keyframes flip {
    0% {
      opacity: 0;
      transform: translateY(0.35em);
      clip-path: inset(0 0 100% 0);
    }
    4%,
    22% {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 0 0);
    }
    26%,
    100% {
      opacity: 0;
      transform: translateY(-0.25em);
      clip-path: inset(100% 0 0 0);
    }
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    color: var(--text-2);
    font-size: 0.9rem;
  }
  .chips li {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
  }
  .chips :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--green);
  }

  .board-wrap {
    padding-bottom: clamp(1.25rem, 3vh, 2rem);
  }
  .board {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr;
    background-color: #111412;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04), 0 20px 50px -20px rgb(0 0 0 / 0.7);
  }
  .board-title {
    grid-column: 1 / -1;
    margin-inline: 14px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    align-items: center;
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--text-2);
  }
  .board-title p {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .board-title .status {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    color: var(--text-3);
  }
  .board-title .status li + li::before {
    content: '·';
    margin-right: 1.2rem;
  }
  .counters {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .counters li {
    display: grid;
    gap: 0.6rem;
    padding: 1.1rem 1.1rem 1.2rem;
    border-right: 1px solid var(--rule);
    align-content: start;
  }
  .readout {
    display: flex;
    align-items: flex-end;
    gap: 0.45rem;
  }
  .readout :global(.seg) {
    --seg-h: clamp(2.2rem, 3.4vw, 3rem);
  }
  .unit {
    font-weight: 800;
    font-stretch: 70%;
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    line-height: 1;
    color: var(--amber);
  }
  .lbl {
    color: var(--text-2);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .cord {
    grid-row: 2;
    grid-column: 2;
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    padding: 0 1.4rem 1.2rem 1.6rem;
    min-width: 250px;
    text-decoration: none;
    color: var(--text);
    background: linear-gradient(180deg, transparent, rgb(255 178 26 / 0.06));
  }
  .cord:hover {
    color: var(--text);
  }
  .rope {
    position: relative;
    width: 2px;
    align-self: stretch;
    background: repeating-linear-gradient(180deg, var(--amber) 0 5px, var(--amber-deep) 5px 9px);
    transform-origin: top;
    transition: transform 0.5s var(--ease-out);
  }
  .handle {
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 30px;
    height: 12px;
    translate: -50% 0;
    background: var(--amber);
    border-radius: 6px;
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.5);
  }
  .cord-text {
    display: grid;
    gap: 0.15rem;
  }
  .cord-text strong {
    font-size: 1.35rem;
    font-weight: 800;
    font-stretch: 72%;
    line-height: 1;
    text-transform: uppercase;
  }
  .cord-text span {
    color: var(--text-2);
    font-size: 0.92rem;
  }
  .cord:hover .rope,
  .cord:focus-visible .rope {
    transform: scaleY(1.06);
  }
  :global(.hero.pulled) .rope {
    transform: scaleY(1.22);
    transition-duration: 0.18s;
  }
  :global(.hero.calling) [data-call-lamp],
  :global(.hero.calling) .board-title .lamp {
    --lamp: var(--amber);
  }

  @media (max-width: 1100px) {
    .counters {
      grid-template-columns: repeat(2, 1fr);
    }
    .counters li:nth-child(2) {
      border-right: 0;
    }
    .counters li:nth-child(-n + 2) {
      border-bottom: 1px solid var(--rule);
    }
  }
  @media (max-width: 1180px) {
    .hero {
      grid-template-rows: repeat(6, auto);
      min-height: 0;
      background: var(--ground);
    }
    .board-title .status {
      display: grid;
      gap: 0.2rem;
    }
    .board-title .status li + li::before {
      content: none;
    }
    .content,
    .c-body {
      display: contents;
    }
    .c-head,
    .c-body > * {
      padding-inline: var(--gutter);
      max-width: none;
    }
    .c-head {
      grid-row: 1;
      padding-top: 1.5rem;
    }
    .stage {
      position: relative;
      inset: auto;
      grid-row: 2;
      height: clamp(250px, 40vh, 440px);
      z-index: 0;
    }
    .stage canvas,
    .stage .poster {
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 84%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 84%, transparent 100%);
    }

    .c-body .ctas {
      grid-row: 3;
      position: relative;
      z-index: 1;
    }
    .c-body .lead {
      grid-row: 4;
      padding-top: 1.5rem;
      max-width: calc(62ch + 2 * var(--gutter));
    }
    .labels {
      display: none;
    }
    .c-body .chips {
      grid-row: 5;
      padding-block: 1.25rem 2rem;
    }
    .board-wrap {
      grid-row: 6;
    }
    .board {
      grid-template-columns: 1fr;
    }
    .cord {
      grid-row: auto;
      grid-column: 1;
      border-top: 1px solid var(--rule);
      padding-top: 1.1rem;
      min-height: 96px;
    }
  }
  @media (max-width: 820px) {
    .stage {
      height: clamp(250px, 34vh, 340px);
    }
  }
  @media (max-width: 480px) {
    .ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  type Line = { setCall: (on: boolean) => void };
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const stage = hero?.querySelector<HTMLElement>('[data-line]');
  const canvas = stage?.querySelector('canvas');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  let line: Line | null = null;

  function setCall(on: boolean) {
    hero?.classList.toggle('calling', on);
    line?.setCall(on);
  }

  hero?.querySelectorAll<HTMLElement>('[data-andon]').forEach((el) => {
    el.addEventListener('pointerenter', () => setCall(true));
    el.addEventListener('pointerleave', () => setCall(false));
    el.addEventListener('focus', () => setCall(true));
    el.addEventListener('blur', () => setCall(false));
  });

  const cord = hero?.querySelector<HTMLAnchorElement>('[data-cord]');
  cord?.addEventListener('click', (e) => {
    if (e.metaKey || e.ctrlKey || e.shiftKey || reduce) return;
    e.preventDefault();
    hero?.classList.add('pulled');
    setCall(true);
    window.setTimeout(() => {
      window.location.href = cord.href;
    }, 520);
  });

  // No throwaway WebGL test context (creating one costs as much as the real scene's):
  // the scene itself tries, and without WebGL the drawn poster simply stays.
  if (hero && stage && canvas && 'WebGLRenderingContext' in window && !conn?.saveData) {
    const go = () =>
      import('../../scripts/line3d')
        .then(({ startLine }) => {
          line = startLine({
            canvas,
            host: stage,
            labels: [...stage.querySelectorAll<HTMLElement>('[data-label]')],
            reducedMotion: reduce,
            compact: window.innerWidth <= 1180,
          });
        })
        .catch(() => {
          /* no WebGL or the chunk failed to load: keep the poster */
        });
    // Start only after the page has loaded and its first frame is on screen,
    // so the headline and buttons never wait for the 3D scene.
    const start = () =>
      requestAnimationFrame(() =>
        setTimeout(() => {
          if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 1500 });
          else setTimeout(go, 300);
        }, 0),
      );
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>
