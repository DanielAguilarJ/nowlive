---
interface Props {
  items: { question: string; answer: string; group?: string }[];
  grouped?: boolean;
}
const { items, grouped = false } = Astro.props;
const groups = grouped
  ? [...new Set(items.map((i) => i.group ?? ''))].map((g) => ({ g, list: items.filter((i) => (i.group ?? '') === g) }))
  : [{ g: '', list: items }];
---

{
  groups.map(({ g, list }) => (
    <div class="group">
      {g && <h2 class="g-title display-3">{g}</h2>}
      <div class="list">
        {list.map((f) => (
          <details>
            <summary>
              <span class="q">{f.question}</span>
              <span class="sign" aria-hidden="true" />
            </summary>
            <p class="a">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  ))
}

<style>
  .group + .group {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .g-title {
    margin-bottom: 1rem;
  }
  .list {
    border-top: 1px solid var(--rule-strong);
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q {
    font-weight: 700;
    font-stretch: 85%;
    font-size: 1.2rem;
    line-height: 1.3;
  }
  summary:hover .q {
    color: var(--amber);
  }
  .sign {
    position: relative;
    width: 28px;
    height: 28px;
    flex: none;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
  }
  .sign::before,
  .sign::after {
    content: '';
    position: absolute;
    inset: 50% 7px auto;
    height: 2px;
    margin-top: -1px;
    background: var(--text);
    transition: transform 0.3s var(--ease-out);
  }
  .sign::after {
    transform: rotate(90deg);
  }
  details[open] .sign::after {
    transform: rotate(0deg);
  }
  details[open] .sign {
    background: var(--amber);
    border-color: var(--amber);
  }
  details[open] .sign::before,
  details[open] .sign::after {
    background: var(--amber-ink);
  }
  .a {
    padding: 0 3.5rem 1.5rem 0;
    color: var(--text-2);
    max-width: 75ch;
  }
</style>
